# Perfetto System Trace Configuration for com.example.detectionexample
# Captures CPU scheduling, frequency, graphics, view rendering, SurfaceFlinger frame timelines,
# camera, and app-level ATrace markers to diagnose UI jank and latency.

buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
duration_ms: 10000

data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "wm"
      atrace_categories: "am"
      atrace_categories: "input"
      atrace_categories: "camera"
      atrace_categories: "hal"
      atrace_categories: "res"
      atrace_categories: "binder_driver"
      atrace_apps: "com.example.detectionexample"
    }
  }
}

# SurfaceFlinger frame timelines for expected vs actual frame deadlines
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

# Process metadata
data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}
